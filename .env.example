# Variables de entorno para Supabase
# Copia este archivo como .env y completa con tus credenciales de Supabase

# URL de tu proyecto Supabase (https://app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=your_supabase_url_here

# Clave pública/anon de tu proyecto Supabase (https://app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
